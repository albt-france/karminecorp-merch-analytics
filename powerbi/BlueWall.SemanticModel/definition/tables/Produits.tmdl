	partition Produits = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DossierDonnees & "produits.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"product_id", type text}, {"nom", type text}, {"type", type text}, {"famille", type text}, {"collection", type text}, {"date_lancement", type date}, {"prix_plein_ttc", type number}, {"cout_unitaire_ht", type number}, {"remise_reelle_20261109", type number}, {"precommande", Int64.Type}, {"origine", type text}, {"jeu_prevision", type text}}, "en-US")
				in
					Typed

