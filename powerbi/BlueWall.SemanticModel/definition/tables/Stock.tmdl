				let
					Source = Csv.Document(File.Contents(DossierDonnees & "stock.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"variant_id", type text}, {"product_id", type text}, {"taille", type text}, {"stock_initial", type number}, {"fabrique_a_la_commande", Int64.Type}, {"unites_vendues", Int64.Type}, {"stock_final", type number}, {"date_rupture", type date}, {"ventes_perdues", Int64.Type}, {"alertes_retour_stock", Int64.Type}}, "en-US")
