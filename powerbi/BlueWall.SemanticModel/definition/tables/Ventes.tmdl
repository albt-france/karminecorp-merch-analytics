	partition Ventes = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DossierDonnees & "ventes.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"line_id", Int64.Type}, {"order_id", Int64.Type}, {"date", type date}, {"client_id", Int64.Type}, {"product_id", type text}, {"variant_id", type text}, {"taille", type text}, {"quantite", Int64.Type}, {"prix_plein_ttc", type number}, {"remise_pct", type number}, {"tranche_remise", type text}, {"periode_commerciale", type text}, {"montant_ht", type number}, {"ca_prix_plein_ht", type number}, {"cout_ht", type number}, {"marge_ht", type number}, {"vendu_sous_cout", Int64.Type}, {"jour_depuis_lancement", Int64.Type}, {"source", type text}, {"pays", type text}, {"client_type", type text}}, "en-US")
				in
					Typed

