	partition Releves = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DossierDonnees & "releves.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"snapshot_date", type date}, {"product_id", Int64.Type}, {"variant_id", Int64.Type}, {"nom", type text}, {"type", type text}, {"collection", type text}, {"taille", type text}, {"prix_plein_ttc", type number}, {"prix_ttc", type number}, {"discount_pct", type number}, {"tranche_remise", type text}, {"disponible", Int64.Type}, {"precommande", Int64.Type}}, "en-US")
				in
					Typed

